{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ScientificScope": {
      "additionalProperties": false,
      "description": "Exact scope that must agree across a result and every supporting claim.",
      "properties": {
        "comparison": {
          "minLength": 1,
          "title": "Comparison",
          "type": "string"
        },
        "entity_scope": {
          "items": {
            "type": "string"
          },
          "title": "Entity Scope",
          "type": "array"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "sample_scope": {
          "items": {
            "type": "string"
          },
          "title": "Sample Scope",
          "type": "array"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "time_scope": {
          "items": {
            "type": "string"
          },
          "title": "Time Scope",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "entity_scope",
        "sample_scope",
        "time_scope",
        "population",
        "comparison"
      ],
      "title": "ScientificScope",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/guide-target-consistency.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sister-guide agreement and target/guide variance decomposition.",
  "properties": {
    "consistency_id": {
      "title": "Consistency Id",
      "type": "string"
    },
    "inconsistent_target_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Inconsistent Target Fraction",
      "type": "number"
    },
    "median_sister_guide_correlation": {
      "maximum": 1,
      "minimum": -1,
      "title": "Median Sister Guide Correlation",
      "type": "number"
    },
    "minimum_sister_guides": {
      "minimum": 2,
      "title": "Minimum Sister Guides",
      "type": "integer"
    },
    "per_target_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "program_contract_id": {
      "minLength": 1,
      "title": "Program Contract Id",
      "type": "string"
    },
    "schema_id": {
      "const": "credo.guide_target_consistency",
      "default": "credo.guide_target_consistency",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/ScientificScope"
    },
    "target_variance_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Target Variance Fraction",
      "type": "number"
    }
  },
  "required": [
    "consistency_id",
    "program_contract_id",
    "scope",
    "per_target_artifact",
    "median_sister_guide_correlation",
    "target_variance_fraction",
    "inconsistent_target_fraction",
    "minimum_sister_guides"
  ],
  "title": "GuideTargetConsistency",
  "type": "object"
}
