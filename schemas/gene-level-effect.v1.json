{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ScientificScope": {
      "additionalProperties": false,
      "description": "Exact scope that must agree across a result and every supporting claim.",
      "properties": {
        "comparison": {
          "minLength": 1,
          "title": "Comparison",
          "type": "string"
        },
        "entity_scope": {
          "items": {
            "type": "string"
          },
          "title": "Entity Scope",
          "type": "array"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "sample_scope": {
          "items": {
            "type": "string"
          },
          "title": "Sample Scope",
          "type": "array"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "time_scope": {
          "items": {
            "type": "string"
          },
          "title": "Time Scope",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "entity_scope",
        "sample_scope",
        "time_scope",
        "population",
        "comparison"
      ],
      "title": "ScientificScope",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/gene-level-effect.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Signed gene effect reconstructed through the sparse program hierarchy.",
  "properties": {
    "decomposition_identity_max_abs_error": {
      "minimum": 0,
      "title": "Decomposition Identity Max Abs Error",
      "type": "number"
    },
    "gene_effect_id": {
      "title": "Gene Effect Id",
      "type": "string"
    },
    "log_fold_change_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "program_contract_id": {
      "minLength": 1,
      "title": "Program Contract Id",
      "type": "string"
    },
    "program_effect_id": {
      "minLength": 1,
      "title": "Program Effect Id",
      "type": "string"
    },
    "schema_id": {
      "const": "credo.gene_level_effect",
      "default": "credo.gene_level_effect",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/ScientificScope"
    },
    "sign_probability_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "standard_error_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "gene_effect_id",
    "program_contract_id",
    "program_effect_id",
    "scope",
    "log_fold_change_artifact",
    "standard_error_artifact",
    "sign_probability_artifact",
    "decomposition_identity_max_abs_error"
  ],
  "title": "GeneLevelEffect",
  "type": "object"
}
