{
  "$id": "https://credo.local/schemas/population-baseline-evaluation-correction.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit bridge from frozen predictions to a separately pinned scorer.",
  "properties": {
    "endpoint_summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Endpoint Summary Sha256",
      "type": "string"
    },
    "evaluation_access_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Access Sha256",
      "type": "string"
    },
    "evaluator_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Implementation Sha256",
      "type": "string"
    },
    "original_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Implementation Sha256",
      "type": "string"
    },
    "original_specification_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Specification Sha256",
      "type": "string"
    },
    "prediction_seal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prediction Seal Sha256",
      "type": "string"
    },
    "previous_evaluation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Evaluation Sha256",
      "type": "string"
    },
    "schema_id": {
      "const": "credo.population_baseline_evaluation_correction",
      "default": "credo.population_baseline_evaluation_correction",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scoring_version": {
      "const": 2,
      "default": 2,
      "title": "Scoring Version",
      "type": "integer"
    }
  },
  "required": [
    "original_specification_sha256",
    "original_implementation_sha256",
    "evaluator_implementation_sha256",
    "prediction_seal_sha256",
    "endpoint_summary_sha256",
    "evaluation_access_sha256",
    "previous_evaluation_sha256"
  ],
  "title": "EvaluationCorrection",
  "type": "object"
}
