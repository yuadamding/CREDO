{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceChannel": {
      "description": "What was measured or withheld; channels are claim-specific.",
      "enum": [
        "engineering_test",
        "model_fit",
        "heldout_donor",
        "heldout_guide_target_shared",
        "heldout_target",
        "heldout_time",
        "independent_cohort",
        "absolute_cell_count",
        "stable_clone_barcode",
        "evolving_barcode",
        "live_cell_tracking",
        "orthogonal_component_assay",
        "proliferation_assay",
        "death_assay",
        "migration_assay",
        "intervention",
        "rescue",
        "epistasis",
        "spatial_colocalization"
      ],
      "title": "EvidenceChannel",
      "type": "string"
    },
    "EvidenceDescriptor": {
      "additionalProperties": false,
      "description": "Independent evidence axes; no claim is authorized from tier alone.",
      "properties": {
        "channel": {
          "$ref": "#/$defs/EvidenceChannel"
        },
        "independence": {
          "$ref": "#/$defs/EvidenceIndependence"
        },
        "multiplicity_family": {
          "minLength": 1,
          "title": "Multiplicity Family",
          "type": "string"
        },
        "prospective_or_exposed_status": {
          "$ref": "#/$defs/EvidenceExposureStatus"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        },
        "unit_of_replication": {
          "minLength": 1,
          "title": "Unit Of Replication",
          "type": "string"
        }
      },
      "required": [
        "tier",
        "channel",
        "independence",
        "unit_of_replication",
        "prospective_or_exposed_status",
        "multiplicity_family"
      ],
      "title": "EvidenceDescriptor",
      "type": "object"
    },
    "EvidenceExposureStatus": {
      "description": "Whether analysis choices were frozen before evidence was inspected.",
      "enum": [
        "prospective",
        "exposed",
        "not_applicable"
      ],
      "title": "EvidenceExposureStatus",
      "type": "string"
    },
    "EvidenceIndependence": {
      "description": "Independence from the data and decisions used to fit the result.",
      "enum": [
        "same_data",
        "in_sample_resampling",
        "heldout_guide_target_shared",
        "heldout_target",
        "heldout_donor",
        "heldout_time",
        "independent_cohort",
        "orthogonal_same_study",
        "external_intervention",
        "direct_observation"
      ],
      "title": "EvidenceIndependence",
      "type": "string"
    },
    "EvidenceTier": {
      "description": "Reporting class; deliberately not a universal scalar ordering.",
      "enum": [
        "E0_engineering",
        "E1_in_sample",
        "E2_held_out",
        "E3_independent_cohort",
        "E4_orthogonal_intervention",
        "E5_direct_measurement"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "LineageEvidenceLevel": {
      "description": "Strongest lineage observation physically present in a study.",
      "enum": [
        "L0_destructive_snapshots",
        "L1_stable_clone_barcodes",
        "L2_heritable_barcodes",
        "L3_live_or_paired_cells"
      ],
      "title": "LineageEvidenceLevel",
      "type": "string"
    },
    "LineageResultSemantics": {
      "description": "Result language authorized by each lineage evidence level.",
      "enum": [
        "population_transition_only",
        "clone_resolved_fate",
        "ancestral_tree",
        "direct_cell_path_validation"
      ],
      "title": "LineageResultSemantics",
      "type": "string"
    },
    "ObservedCheckpoint": {
      "additionalProperties": false,
      "description": "One observed checkpoint on a physical-time scale.",
      "properties": {
        "checkpoint_id": {
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "physical_time": {
          "title": "Physical Time",
          "type": "number"
        }
      },
      "required": [
        "checkpoint_id",
        "physical_time"
      ],
      "title": "ObservedCheckpoint",
      "type": "object"
    },
    "ScientificScope": {
      "additionalProperties": false,
      "description": "Exact scope that must agree across a result and every supporting claim.",
      "properties": {
        "comparison": {
          "minLength": 1,
          "title": "Comparison",
          "type": "string"
        },
        "entity_scope": {
          "items": {
            "type": "string"
          },
          "title": "Entity Scope",
          "type": "array"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "sample_scope": {
          "items": {
            "type": "string"
          },
          "title": "Sample Scope",
          "type": "array"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "time_scope": {
          "items": {
            "type": "string"
          },
          "title": "Time Scope",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "entity_scope",
        "sample_scope",
        "time_scope",
        "population",
        "comparison"
      ],
      "title": "ScientificScope",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/trajectory-result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A transition-law result whose lineage language is evidence-gated.",
  "properties": {
    "capability_assessment_id": {
      "minLength": 1,
      "title": "Capability Assessment Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceDescriptor"
      },
      "title": "Evidence",
      "type": "array"
    },
    "heldout_time_evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "individual_cell_paths_claimed": {
      "default": false,
      "title": "Individual Cell Paths Claimed",
      "type": "boolean"
    },
    "lineage_evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lineage_level": {
      "$ref": "#/$defs/LineageEvidenceLevel"
    },
    "observed_checkpoints": {
      "items": {
        "$ref": "#/$defs/ObservedCheckpoint"
      },
      "title": "Observed Checkpoints",
      "type": "array"
    },
    "predicted_finite_measures": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_id": {
      "const": "credo.trajectory_result",
      "default": "credo.trajectory_result",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/ScientificScope"
    },
    "semantics": {
      "$ref": "#/$defs/LineageResultSemantics"
    },
    "semigroup_evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "study_id": {
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "terminal_fate_probabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trajectory_result_id": {
      "title": "Trajectory Result Id",
      "type": "string"
    },
    "transition_kernels": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "uncertainty": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "trajectory_result_id",
    "study_id",
    "capability_assessment_id",
    "scope",
    "evidence",
    "lineage_level",
    "semantics",
    "observed_checkpoints",
    "predicted_finite_measures",
    "transition_kernels",
    "uncertainty"
  ],
  "title": "TrajectoryResult",
  "type": "object"
}
