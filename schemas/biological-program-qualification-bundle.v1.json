{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BaselineMetric": {
      "additionalProperties": false,
      "description": "Comparable held-out count metric for one method.",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/BaselineName"
        },
        "mean_log_likelihood_per_count": {
          "title": "Mean Log Likelihood Per Count",
          "type": "number"
        },
        "mean_negative_log_likelihood_per_cell": {
          "minimum": 0,
          "title": "Mean Negative Log Likelihood Per Cell",
          "type": "number"
        }
      },
      "required": [
        "baseline",
        "mean_log_likelihood_per_count",
        "mean_negative_log_likelihood_per_cell"
      ],
      "title": "BaselineMetric",
      "type": "object"
    },
    "BaselineName": {
      "description": "Frozen Dev40-B comparator set.",
      "enum": [
        "exact_global_gene_frequency",
        "pseudobulk_negative_binomial",
        "per_gene_differential_expression",
        "gsfa_style_sparse_factors",
        "target_average",
        "control_only"
      ],
      "title": "BaselineName",
      "type": "string"
    },
    "CountLinkedProgramContract": {
      "additionalProperties": false,
      "description": "Static/checkpoint-conditional head, deliberately uncoupled from dynamics.",
      "properties": {
        "checkpoint_dependence_enabled": {
          "title": "Checkpoint Dependence Enabled",
          "type": "boolean"
        },
        "checkpoint_schema_modified": {
          "const": false,
          "default": false,
          "title": "Checkpoint Schema Modified",
          "type": "boolean"
        },
        "checkpoint_time_semantics": {
          "const": "linear_continuous_physical_time",
          "default": "linear_continuous_physical_time",
          "title": "Checkpoint Time Semantics",
          "type": "string"
        },
        "checkpoint_time_values": {
          "items": {
            "type": "number"
          },
          "title": "Checkpoint Time Values",
          "type": "array"
        },
        "checkpoints": {
          "exclusiveMinimum": 0,
          "title": "Checkpoints",
          "type": "integer"
        },
        "control_guide_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Control Guide Indices",
          "type": "array"
        },
        "control_reference_centered": {
          "const": true,
          "default": true,
          "title": "Control Reference Centered",
          "type": "boolean"
        },
        "count_likelihood": {
          "$ref": "#/$defs/NegativeBinomialSemantics"
        },
        "donor_or_sample_effects_enabled": {
          "title": "Donor Or Sample Effects Enabled",
          "type": "boolean"
        },
        "dynamics_coupled": {
          "const": false,
          "default": false,
          "title": "Dynamics Coupled",
          "type": "boolean"
        },
        "equation": {
          "const": "log_mu=log_library+sample_gene+state_gene+W@(reference+target+efficacy*guide)",
          "default": "log_mu=log_library+sample_gene+state_gene+W@(reference+target+efficacy*guide)",
          "title": "Equation",
          "type": "string"
        },
        "feature_order_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Order Sha256",
          "type": "string"
        },
        "fit_row_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fit Row Ids Sha256",
          "type": "string"
        },
        "gene_specific_dispersion": {
          "const": true,
          "default": true,
          "title": "Gene Specific Dispersion",
          "type": "boolean"
        },
        "genes": {
          "exclusiveMinimum": 1,
          "title": "Genes",
          "type": "integer"
        },
        "guide_deviation_l2_weight": {
          "exclusiveMinimum": 0,
          "title": "Guide Deviation L2 Weight",
          "type": "number"
        },
        "guide_target_map_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Guide Target Map Sha256",
          "type": "string"
        },
        "guides": {
          "exclusiveMinimum": 0,
          "title": "Guides",
          "type": "integer"
        },
        "heldout_target_mode": {
          "$ref": "#/$defs/HeldoutTargetMode"
        },
        "hierarchy_equation": {
          "const": "a_ref+a_target+q_guide*a_guide",
          "default": "a_ref+a_target+q_guide*a_guide",
          "title": "Hierarchy Equation",
          "type": "string"
        },
        "library_size_semantics": {
          "$ref": "#/$defs/LibrarySizeSemantics"
        },
        "loading_l1_weight": {
          "exclusiveMinimum": 0,
          "title": "Loading L1 Weight",
          "type": "number"
        },
        "program_contract_id": {
          "title": "Program Contract Id",
          "type": "string"
        },
        "programs": {
          "exclusiveMinimum": 0,
          "title": "Programs",
          "type": "integer"
        },
        "raw_nonnegative_integer_counts_required": {
          "const": true,
          "default": true,
          "title": "Raw Nonnegative Integer Counts Required",
          "type": "boolean"
        },
        "samples": {
          "exclusiveMinimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "schema_id": {
          "const": "credo.count_linked_program_contract",
          "default": "credo.count_linked_program_contract",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sparse_loading_prior": {
          "$ref": "#/$defs/SparseLoadingPrior"
        },
        "state_dependence_enabled": {
          "title": "State Dependence Enabled",
          "type": "boolean"
        },
        "state_dimension": {
          "minimum": 0,
          "title": "State Dimension",
          "type": "integer"
        },
        "target_descriptor_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_effect_l2_weight": {
          "exclusiveMinimum": 0,
          "title": "Target Effect L2 Weight",
          "type": "number"
        },
        "target_guide_hierarchy_enabled": {
          "const": true,
          "default": true,
          "title": "Target Guide Hierarchy Enabled",
          "type": "boolean"
        },
        "targets": {
          "exclusiveMinimum": 0,
          "title": "Targets",
          "type": "integer"
        }
      },
      "required": [
        "program_contract_id",
        "count_likelihood",
        "library_size_semantics",
        "sparse_loading_prior",
        "state_dependence_enabled",
        "checkpoint_dependence_enabled",
        "checkpoint_time_values",
        "donor_or_sample_effects_enabled",
        "heldout_target_mode",
        "feature_order_sha256",
        "guide_target_map_sha256",
        "fit_row_ids_sha256",
        "genes",
        "programs",
        "state_dimension",
        "samples",
        "checkpoints",
        "targets",
        "guides",
        "control_guide_indices",
        "loading_l1_weight",
        "guide_deviation_l2_weight",
        "target_effect_l2_weight"
      ],
      "title": "CountLinkedProgramContract",
      "type": "object"
    },
    "GeneLevelEffect": {
      "additionalProperties": false,
      "description": "Signed gene effect reconstructed through the sparse program hierarchy.",
      "properties": {
        "decomposition_identity_max_abs_error": {
          "minimum": 0,
          "title": "Decomposition Identity Max Abs Error",
          "type": "number"
        },
        "gene_effect_id": {
          "title": "Gene Effect Id",
          "type": "string"
        },
        "log_fold_change_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "program_contract_id": {
          "minLength": 1,
          "title": "Program Contract Id",
          "type": "string"
        },
        "program_effect_id": {
          "minLength": 1,
          "title": "Program Effect Id",
          "type": "string"
        },
        "schema_id": {
          "const": "credo.gene_level_effect",
          "default": "credo.gene_level_effect",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/ScientificScope"
        },
        "sign_probability_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "standard_error_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "gene_effect_id",
        "program_contract_id",
        "program_effect_id",
        "scope",
        "log_fold_change_artifact",
        "standard_error_artifact",
        "sign_probability_artifact",
        "decomposition_identity_max_abs_error"
      ],
      "title": "GeneLevelEffect",
      "type": "object"
    },
    "GuideTargetConsistency": {
      "additionalProperties": false,
      "description": "Sister-guide agreement and target/guide variance decomposition.",
      "properties": {
        "consistency_id": {
          "title": "Consistency Id",
          "type": "string"
        },
        "inconsistent_target_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Inconsistent Target Fraction",
          "type": "number"
        },
        "median_sister_guide_correlation": {
          "maximum": 1,
          "minimum": -1,
          "title": "Median Sister Guide Correlation",
          "type": "number"
        },
        "minimum_sister_guides": {
          "minimum": 2,
          "title": "Minimum Sister Guides",
          "type": "integer"
        },
        "per_target_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "program_contract_id": {
          "minLength": 1,
          "title": "Program Contract Id",
          "type": "string"
        },
        "schema_id": {
          "const": "credo.guide_target_consistency",
          "default": "credo.guide_target_consistency",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/ScientificScope"
        },
        "target_variance_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Target Variance Fraction",
          "type": "number"
        }
      },
      "required": [
        "consistency_id",
        "program_contract_id",
        "scope",
        "per_target_artifact",
        "median_sister_guide_correlation",
        "target_variance_fraction",
        "inconsistent_target_fraction",
        "minimum_sister_guides"
      ],
      "title": "GuideTargetConsistency",
      "type": "object"
    },
    "HeldoutTargetMode": {
      "description": "Whether an unseen target has legal predictive information.",
      "enum": [
        "identifier_only_not_eligible",
        "predeclared_target_descriptors"
      ],
      "title": "HeldoutTargetMode",
      "type": "string"
    },
    "LibrarySizeSemantics": {
      "description": "The library term is observed exposure, never a fitted biological effect.",
      "enum": [
        "observed_total_count_log_offset"
      ],
      "title": "LibrarySizeSemantics",
      "type": "string"
    },
    "NegativeBinomialSemantics": {
      "description": "Frozen NB parameterization used by the program head.",
      "enum": [
        "nb2_gene_dispersion_var_mu_plus_mu_squared_over_theta"
      ],
      "title": "NegativeBinomialSemantics",
      "type": "string"
    },
    "PerturbationProgramEffect": {
      "additionalProperties": false,
      "description": "Control, target, and guide-deviation program effects for one scope.",
      "properties": {
        "guide_deviation_activity": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "guide_efficiency": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "guide_ids": {
          "items": {
            "type": "string"
          },
          "title": "Guide Ids",
          "type": "array"
        },
        "perturbation_id": {
          "minLength": 1,
          "title": "Perturbation Id",
          "type": "string"
        },
        "program_contract_id": {
          "minLength": 1,
          "title": "Program Contract Id",
          "type": "string"
        },
        "program_effect_id": {
          "title": "Program Effect Id",
          "type": "string"
        },
        "reference_activity": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_id": {
          "const": "credo.perturbation_program_effect",
          "default": "credo.perturbation_program_effect",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/ScientificScope"
        },
        "target_activity": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "program_effect_id",
        "program_contract_id",
        "scope",
        "perturbation_id",
        "target_id",
        "guide_ids",
        "reference_activity",
        "target_activity",
        "guide_deviation_activity",
        "guide_efficiency"
      ],
      "title": "PerturbationProgramEffect",
      "type": "object"
    },
    "ProgramDefinition": {
      "additionalProperties": false,
      "description": "One sparse signed gene program, without a biological-name claim.",
      "properties": {
        "l1_norm": {
          "exclusiveMinimum": 0,
          "title": "L1 Norm",
          "type": "number"
        },
        "l2_norm": {
          "exclusiveMinimum": 0,
          "title": "L2 Norm",
          "type": "number"
        },
        "loading_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "loading_threshold": {
          "exclusiveMinimum": 0,
          "title": "Loading Threshold",
          "type": "number"
        },
        "negative_genes": {
          "minimum": 0,
          "title": "Negative Genes",
          "type": "integer"
        },
        "nonzero_genes": {
          "minimum": 0,
          "title": "Nonzero Genes",
          "type": "integer"
        },
        "positive_genes": {
          "minimum": 0,
          "title": "Positive Genes",
          "type": "integer"
        },
        "program_contract_id": {
          "minLength": 1,
          "title": "Program Contract Id",
          "type": "string"
        },
        "program_definition_id": {
          "title": "Program Definition Id",
          "type": "string"
        },
        "program_index": {
          "minimum": 0,
          "title": "Program Index",
          "type": "integer"
        },
        "schema_id": {
          "const": "credo.program_definition",
          "default": "credo.program_definition",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_derived_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Derived Label"
        }
      },
      "required": [
        "program_definition_id",
        "program_contract_id",
        "program_index",
        "loading_artifact",
        "loading_threshold",
        "nonzero_genes",
        "positive_genes",
        "negative_genes",
        "l1_norm",
        "l2_norm"
      ],
      "title": "ProgramDefinition",
      "type": "object"
    },
    "ProgramNullContract": {
      "additionalProperties": false,
      "description": "Frozen negative controls for false-program inclusion.",
      "properties": {
        "maximum_program_inclusion_rate": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Maximum Program Inclusion Rate",
          "type": "number"
        },
        "null_contract_id": {
          "title": "Null Contract Id",
          "type": "string"
        },
        "null_families": {
          "items": {
            "enum": [
              "control_label_permutation",
              "target_within_checkpoint_permutation",
              "negative_binomial_no_program"
            ],
            "type": "string"
          },
          "title": "Null Families",
          "type": "array"
        },
        "replicate_count": {
          "minimum": 20,
          "title": "Replicate Count",
          "type": "integer"
        },
        "schema_id": {
          "const": "credo.program_null_contract",
          "default": "credo.program_null_contract",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "selection_threshold_frozen_before_nulls": {
          "const": true,
          "default": true,
          "title": "Selection Threshold Frozen Before Nulls",
          "type": "boolean"
        }
      },
      "required": [
        "null_contract_id",
        "null_families",
        "replicate_count",
        "maximum_program_inclusion_rate"
      ],
      "title": "ProgramNullContract",
      "type": "object"
    },
    "ProgramQualificationProtocol": {
      "additionalProperties": false,
      "description": "Content-addressed Dev40-B optimization, split, and threshold freeze.",
      "properties": {
        "baselines": {
          "items": {
            "$ref": "#/$defs/BaselineName"
          },
          "title": "Baselines",
          "type": "array"
        },
        "effect_inclusion_threshold": {
          "exclusiveMinimum": 0,
          "title": "Effect Inclusion Threshold",
          "type": "number"
        },
        "evaluation_dispersion_semantics": {
          "const": "training_only_method_of_moments_shared_across_candidates",
          "default": "training_only_method_of_moments_shared_across_candidates",
          "title": "Evaluation Dispersion Semantics",
          "type": "string"
        },
        "gradient_clip_norm": {
          "exclusiveMinimum": 0,
          "title": "Gradient Clip Norm",
          "type": "number"
        },
        "guide_deviation_l2_weight": {
          "exclusiveMinimum": 0,
          "title": "Guide Deviation L2 Weight",
          "type": "number"
        },
        "inner_validation_fraction": {
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "title": "Inner Validation Fraction",
          "type": "number"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "loading_inclusion_threshold": {
          "exclusiveMinimum": 0,
          "title": "Loading Inclusion Threshold",
          "type": "number"
        },
        "loading_l1_weight": {
          "exclusiveMinimum": 0,
          "title": "Loading L1 Weight",
          "type": "number"
        },
        "max_epochs": {
          "exclusiveMinimum": 0,
          "title": "Max Epochs",
          "type": "integer"
        },
        "maximum_null_inclusion_rate": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Maximum Null Inclusion Rate",
          "type": "number"
        },
        "minibatch_size": {
          "exclusiveMinimum": 0,
          "title": "Minibatch Size",
          "type": "integer"
        },
        "minimum_delta": {
          "minimum": 0,
          "title": "Minimum Delta",
          "type": "number"
        },
        "minimum_donor_loading_stability": {
          "maximum": 1,
          "minimum": -1,
          "title": "Minimum Donor Loading Stability",
          "type": "number"
        },
        "minimum_gene_sign_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Gene Sign Accuracy",
          "type": "number"
        },
        "minimum_log_likelihood_improvement": {
          "title": "Minimum Log Likelihood Improvement",
          "type": "number"
        },
        "minimum_seed_loading_stability": {
          "maximum": 1,
          "minimum": -1,
          "title": "Minimum Seed Loading Stability",
          "type": "number"
        },
        "minimum_sister_guide_correlation": {
          "maximum": 1,
          "minimum": -1,
          "title": "Minimum Sister Guide Correlation",
          "type": "number"
        },
        "null_fit_epochs": {
          "exclusiveMinimum": 0,
          "title": "Null Fit Epochs",
          "type": "integer"
        },
        "null_replicates": {
          "minimum": 20,
          "title": "Null Replicates",
          "type": "integer"
        },
        "patience": {
          "exclusiveMinimum": 0,
          "title": "Patience",
          "type": "integer"
        },
        "qualification_protocol_id": {
          "title": "Qualification Protocol Id",
          "type": "string"
        },
        "schema_id": {
          "const": "credo.program_qualification_protocol",
          "default": "credo.program_qualification_protocol",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sparse_factor_rank": {
          "exclusiveMinimum": 0,
          "title": "Sparse Factor Rank",
          "type": "integer"
        },
        "split_kinds": {
          "items": {
            "$ref": "#/$defs/ProgramSplitKind"
          },
          "title": "Split Kinds",
          "type": "array"
        },
        "stability_seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Stability Seeds",
          "type": "array"
        },
        "target_effect_l2_weight": {
          "exclusiveMinimum": 0,
          "title": "Target Effect L2 Weight",
          "type": "number"
        },
        "weight_decay": {
          "minimum": 0,
          "title": "Weight Decay",
          "type": "number"
        }
      },
      "required": [
        "qualification_protocol_id",
        "split_kinds",
        "baselines",
        "stability_seeds",
        "sparse_factor_rank",
        "null_replicates",
        "null_fit_epochs",
        "minimum_log_likelihood_improvement",
        "minimum_gene_sign_accuracy",
        "minimum_seed_loading_stability",
        "minimum_donor_loading_stability",
        "minimum_sister_guide_correlation",
        "maximum_null_inclusion_rate",
        "effect_inclusion_threshold",
        "loading_inclusion_threshold",
        "inner_validation_fraction",
        "seed",
        "learning_rate",
        "weight_decay",
        "max_epochs",
        "patience",
        "minimum_delta",
        "gradient_clip_norm",
        "minibatch_size",
        "loading_l1_weight",
        "guide_deviation_l2_weight",
        "target_effect_l2_weight"
      ],
      "title": "ProgramQualificationProtocol",
      "type": "object"
    },
    "ProgramQualificationReceipt": {
      "additionalProperties": false,
      "description": "Complete Dev40-B promotion gate.",
      "properties": {
        "donor_stability_pass": {
