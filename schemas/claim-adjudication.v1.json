{
  "$defs": {
    "ClaimDecision": {
      "description": "Fail-closed disposition for one typed claim.",
      "enum": [
        "permitted",
        "model_attribution_only",
        "blocked"
      ],
      "title": "ClaimDecision",
      "type": "string"
    },
    "EvidenceChannel": {
      "description": "What was measured or withheld; channels are claim-specific.",
      "enum": [
        "engineering_test",
        "model_fit",
        "heldout_donor",
        "heldout_guide_target_shared",
        "heldout_target",
        "heldout_time",
        "independent_cohort",
        "absolute_cell_count",
        "stable_clone_barcode",
        "evolving_barcode",
        "live_cell_tracking",
        "orthogonal_component_assay",
        "proliferation_assay",
        "death_assay",
        "migration_assay",
        "intervention",
        "rescue",
        "epistasis",
        "spatial_colocalization"
      ],
      "title": "EvidenceChannel",
      "type": "string"
    },
    "EvidenceTier": {
      "description": "Reporting class; deliberately not a universal scalar ordering.",
      "enum": [
        "E0_engineering",
        "E1_in_sample",
        "E2_held_out",
        "E3_independent_cohort",
        "E4_orthogonal_intervention",
        "E5_direct_measurement"
      ],
      "title": "EvidenceTier",
      "type": "string"
    }
  },
  "$id": "https://credo.local/schemas/claim-adjudication.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine-readable authorization and deterministic rendered wording.",
  "properties": {
    "adjudication_id": {
      "title": "Adjudication Id",
      "type": "string"
    },
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "capability_assessment_id": {
      "minLength": 1,
      "title": "Capability Assessment Id",
      "type": "string"
    },
    "claim_id": {
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "claim_request_id": {
      "minLength": 1,
      "title": "Claim Request Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ClaimDecision"
    },
    "evidence_channels": {
      "items": {
        "$ref": "#/$defs/EvidenceChannel"
      },
      "title": "Evidence Channels",
      "type": "array"
    },
    "evidence_tiers": {
      "items": {
        "$ref": "#/$defs/EvidenceTier"
      },
      "title": "Evidence Tiers",
      "type": "array"
    },
    "permitted_wording": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permitted Wording"
    },
    "schema_id": {
      "const": "credo.claim_adjudication",
      "default": "credo.claim_adjudication",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "adjudication_id",
    "claim_id",
    "claim_request_id",
    "capability_assessment_id",
    "decision",
    "evidence_tiers",
    "evidence_channels",
    "blocking_reasons"
  ],
  "title": "ClaimAdjudication",
  "type": "object"
}
